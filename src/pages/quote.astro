---
import { Image } from 'astro:assets';
import Main from '../layouts/Main.astro';

import backgroundHexigonsImage02 from '../assets/background-hexigons-02.svg';
import ContactForm from '../components/ContactForm.astro';
---

<Main title="Get a Quote">
    <section class="relative pb-32">
        <div
            class="container-section px py-24 h-full grid place-content-center"
        >
            <h1 class="h1 text-center">Get a Quote</h1>
            <p class="mt-3 text-center mx-auto paragraph">
                text goes here
            </p>
        </div>
        <Image
            class="absolute -z-10 inset-0 w-full h-full object-cover opacity-[2%]"
            src={backgroundHexigonsImage02}
            alt=""
        />
        <ContactForm />
    </section>
</Main>
