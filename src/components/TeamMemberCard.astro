---
import { Image } from 'astro:assets';

const { name, title, bio, image } = Astro.props;
---

<div class="flex gap-8 w-full border shadow-xl rounded-3xl mt-40">
    <div class="flex-1">
        <Image
            src={image}
            alt={title}
            class="aspect-[3/4] object-cover object-top rounded-xl -px-20 -mt-40"
            widths={[350, 420, 440, 550, 640, image.width]}
            sizes="(min-width: 1280px) 33vw, (min-width: 1024px) 50vw, 100vw"
            quality="mid"
        />
    </div>
    <div class="flex-1 my-auto mr-10 py-5">
        <p class="text-2xl font-bold">
            {name}
        </p>
        <p>{bio && <p class="mt-1">{bio}</p>}</p>
    </div>
</div>
